# Copy this to .env and fill in your values

# Debug mode — set to true to enable verbose logging on both backend and frontend
# Backend: sets LOG_LEVEL=DEBUG, logs full tracebacks for all 500 errors
# Frontend: logs all errors/rejections/console.errors with full stack traces to the browser console
DEBUG_MODE=false
VITE_DEBUG_MODE=false

# Log level — controls verbosity of backend structlog output
# DEBUG: full prompt previews, every LLM response, memory chunks, VAD details
# INFO:  transcript decisions, LLM routes, response previews (recommended for tuning)
# WARNING: only failures and suppressed responses
LOG_LEVEL=INFO

# Anthropic Claude API key
ANTHROPIC_API_KEY=REMOVED

# Audio device index (run scripts/list_audio_devices.py to find yours)
MIC_DEVICE_INDEX=0

# Ollama base URL and model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Database path
DATABASE_URL=sqlite:///./data/campaign.db

# Backend host/port
HOST=0.0.0.0
PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
